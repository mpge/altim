<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe so Windows starts the process without a console window. On Linux
         and macOS the SDK treats this exactly like Exe. -->
    <OutputType>WinExe</OutputType>
    <RootNamespace>Altim.App</RootNamespace>
    <AssemblyName>Altim</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- On Windows the composition root builds against the real platform layer.

       Altim.Platform.Windows multi-targets: net10.0 is a facade that contains no
       types at all, because every file in that project is wrapped in #if WINDOWS,
       and net10.0-windows10.0.19041.0 carries Shell_NotifyIcon, the Run key, the
       power events and the notification host. A net10.0 composition root binds to
       the facade and therefore has no tray, no notifications and no autostart, so
       on Windows this project takes the Windows-flavoured framework and everything
       Windows-specific in it sits behind the same WINDOWS symbol.

       On any other host the condition is false, the framework stays plain net10.0
       from Directory.Build.props, and the app builds and runs against the macOS and
       Linux halves of Composition/PlatformStack.cs, which are ordinary net10.0
       assemblies and need no inner build of their own.

       AltimPortableBuild=true forces that face on a Windows host, which is the only
       way to compile the shape the Linux CI job compiles without a Linux machine.
       It is a verification switch and nothing sets it by default:

       The exact command is in packaging/README.md, under "Verifying the portable
       face on Windows". It does not live here because it needs a double-hyphen
       switch, and a double hyphen cannot appear inside an XML comment. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(AltimPortableBuild)' != 'true'">
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- GetClassNameW writes into a caller supplied buffer; the composition root
         reads the foreground window's class to tell a tray click apart from a real
         deactivation. That is the only pointer in this project. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>..\..\assets\icons\altim.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Native AOT, Windows and Release only, and only when a runtime identifier has
       actually been chosen — so `dotnet build` and a plain `dotnet publish` behave
       exactly as they did before, and only the packaging command opts in:

           dotnet publish src/Altim.App -c Release -r win-x64

       Verified on 2026-09-16 against Windows 11 26200 with the VS 2022 Build Tools
       C++ workload. It is worth the step: measured against the same machine and the
       same code, native compilation took cold start to tray icon from 627ms to 390ms.

       Re-measured on 2026-09-18, both builds 150 seconds after launch with no window
       opened: 98MB working set against 147MB. The private working set, which is what
       the budget is stated in, moves far less — 42MB against 48MB — because most of
       what ahead-of-time compilation removes is mapped image pages rather than memory
       Altim was spending.

       The ILC link step shells out to vswhere, which the Build Tools install does
       not put on PATH. If the link fails with "'vswhere.exe' is not recognized",
       prepend "%ProgramFiles(x86)%\Microsoft Visual Studio\Installer" to PATH. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' != '' and $(TargetFramework.Contains('-windows'))">
    <PublishAot>true</PublishAot>
    <InvariantTimezone>false</InvariantTimezone>
  </PropertyGroup>

  <!-- Idle footprint. ARCHITECTURE.md's budgets are under 55MB of private working set,
       under 110MB of working set, and under 5% of one core.

       Four numbers this comment has cited were retired, and the reasons are worth keeping
       because they are the same reason four times: 80MB, because nothing ever met it;
       "0.1% average", because a share of the machine is not a property of the program;
       2% of one core, which the CPU budget moved off once child processes were counted;
       and "115.5MB working set", measured here on 2026-09-17 after a settle too short to
       have settled, from a single run of a figure that moves by 13MB between runs.

       Measured 2026-09-18 on the native-compiled build, mean of six interleaved runs,
       150 seconds after launch with no window ever opened, against the real provider
       stores while an agent was writing: 42MB private working set, 98MB working set, and
       2.51% of one core over the last 120 seconds of each run.

       These settings are part of meeting that, and they are in force in the Native AOT
       build: an empty application built with the same properties and published the same
       way reports ServerGC=False, ConcurrentGC=False and GCConserveMem=5 from
       GC.GetConfigurationVariables(), Altim.exe carries the same embedded configuration
       blob, and running this binary with DOTNET_GCConserveMemory=0 moves the working set
       by 1.3MB, which it could not do if 5 were not otherwise applying.

       What they are not is the reason the number is what it is. ConserveMemory 0, 5 and 9
       measured 124.2MB, 122.9MB and 119.8MB on the build that preceded the sliding read
       window; the 27MB that separated that build from this one was buffers a pool was
       holding, which no collector setting can return. See ARCHITECTURE.md. -->

  <PropertyGroup>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <!-- Packaging identity. One version number reaches every artefact: the Velopack
       release and its Setup.exe, the .deb and .rpm, the AppImage file name and the
       macOS CFBundleShortVersionString are all derived from $(Version). The release
       workflow overrides it from the tag with -p:Version=, so this default is what a
       local `dotnet publish` stamps and nothing more. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <AssemblyTitle>Altim</AssemblyTitle>
    <Description>AI usage, at a glance.</Description>
    <Authors>mpge</Authors>
    <Copyright>Copyright (c) 2026 mpge</Copyright>
  </PropertyGroup>

  <!-- Publish payload. The app has no localised resources of its own, and neither
       does anything it ships; this keeps a dependency that gains satellite assemblies
       later from quietly adding a folder per language to every installer. -->
  <PropertyGroup>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>


  <ItemGroup>
    <ProjectReference Include="..\Altim.UI\Altim.UI.csproj" />
    <ProjectReference Include="..\Altim.Storage\Altim.Storage.csproj" />
    <ProjectReference Include="..\Altim.Providers\Altim.Providers.csproj" />
    <ProjectReference Include="..\Altim.Providers.Claude\Altim.Providers.Claude.csproj" />
    <ProjectReference Include="..\Altim.Providers.Codex\Altim.Providers.Codex.csproj" />
    <ProjectReference Include="..\Altim.Providers.Gemini\Altim.Providers.Gemini.csproj" />
    <!-- All three platform projects are referenced unconditionally; each resolves
         to the closest face its own target frameworks offer, so this builds on
         every OS. The composition root picks one at run time with
         OperatingSystem.IsWindows() and friends. -->
    <ProjectReference Include="..\Altim.Platform.Windows\Altim.Platform.Windows.csproj" />
    <ProjectReference Include="..\Altim.Platform.MacOS\Altim.Platform.MacOS.csproj" />
    <ProjectReference Include="..\Altim.Platform.Linux\Altim.Platform.Linux.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- Velopack is the Windows installer and updater. It is referenced here rather
       than in a platform project because the one call it needs — VelopackApp.Build().Run()
       as the first statement in Main — belongs to the entry point, and because the
       package is inert on the platforms that do not use it. The version is pinned
       centrally in Directory.Packages.props with everything else. -->
  <ItemGroup>
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <!-- The Avalonia developer tools are compiled in for Debug and stripped from
       every other configuration, so Release carries no diagnostics surface. -->
  <ItemGroup>
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">none</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
