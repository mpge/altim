<!--
  The tray panel's contents.

  Five sections split by 1px rules: the header, the providers, the resets, the status and the
  one action. The rules are full bleed, so the padding belongs to each section rather than to
  the panel.

  A provider is one line here, not a stack of metric rows: the mark, the name, and every window
  it reports as "5h 42% . 7d 68%" with the figures in the ink and the windows in grey. There
  are no meters. A meter reports a level by its width, and at this width, three of them stacked
  under one another report a texture. The panel answers "where am I"; the window answers "how
  did I get here", and the disclosure beside each name is how you get from one to the other.

  Nothing here is a card. The panel is one surface; whitespace and the rules do the separating.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:design="using:Altim.UI.ViewModels.Design"
             xmlns:vm="using:Altim.UI.ViewModels"
             x:Class="Altim.UI.Views.PopupView"
             x:DataType="vm:PopupViewModel"
             Design.DataContext="{x:Static design:DesignData.Popup}">

  <UserControl.Styles>
    <StyleInclude Source="avares://Altim.UI/Views/Shared.axaml" />
  </UserControl.Styles>

  <StackPanel>

    <!-- Header -->
    <Grid Margin="16,12" ColumnDefinitions="Auto,*,Auto">
      <Border Grid.Column="0" Theme="{DynamicResource AltimBrandMark}" />
      <TextBlock Grid.Column="1"
                 Margin="8,0,0,0"
                 VerticalAlignment="Center"
                 Theme="{DynamicResource AltimHeadingText}"
                 Text="{Binding Title}" />
      <Button Grid.Column="2"
              Theme="{DynamicResource AltimIconButton}"
              Command="{Binding OpenSettingsCommand}">
        <Path Classes="icon gear quiet" />
      </Button>
    </Grid>

    <Separator />

    <!-- Providers -->
    <TextBlock IsVisible="{Binding !HasProviders}"
               Margin="{DynamicResource AltimInset16}"
               Theme="{DynamicResource AltimBodyText}"
               Text="{Binding NoProvidersText}" />

    <ItemsControl IsVisible="{Binding HasProviders}"
                  Margin="{DynamicResource AltimInset16}"
                  ItemsSource="{Binding Providers}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="{DynamicResource AltimSpace16}" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ProviderViewModel">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">

            <Path Grid.Row="0"
                  Grid.RowSpan="2"
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Classes="glyph large"
                  Classes.anthropic="{Binding IsAnthropic}"
                  Classes.openai="{Binding IsOpenAI}" />

            <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0" ColumnDefinitions="Auto,Auto,*">
              <TextBlock Grid.Column="0"
                         VerticalAlignment="Center"
                         Theme="{DynamicResource AltimHeadingText}"
                         Text="{Binding DisplayName}" />
              <Button Grid.Column="1"
                      Margin="2,0,0,0"
                      VerticalAlignment="Center"
                      Theme="{DynamicResource AltimIconButton}"
                      Command="{Binding OpenCommand}">
                <Path Classes="icon next quiet" />
              </Button>
            </Grid>

            <!-- The one line, or the sentence that stands in for it. -->
            <ItemsControl Grid.Row="1"
                          Grid.Column="1"
                          Margin="12,2,0,0"
                          IsVisible="{Binding HasCompactMetrics}"
                          ItemsSource="{Binding CompactMetrics}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CompactMetricViewModel">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Theme="{DynamicResource AltimLabelText}"
                               IsVisible="{Binding ShowsSeparator}"
                               Text="  ·  " />
                    <TextBlock Theme="{DynamicResource AltimLabelMetricText}"
                               Text="{Binding Label}" />
                    <TextBlock Margin="4,0,0,0"
                               Theme="{DynamicResource AltimBodyMetricText}"
                               FontWeight="{DynamicResource AltimFontWeightHeading}"
                               Text="{Binding ValueText}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- A failed reading: the sentence and the one action that can change it. -->
            <StackPanel Grid.Row="1"
                        Grid.Column="1"
                        Margin="12,6,0,0"
                        IsVisible="{Binding HasError}"
                        Spacing="{DynamicResource AltimSpace8}">
              <TextBlock Theme="{DynamicResource AltimBodyText}" Text="{Binding ErrorText}" />
              <Button HorizontalAlignment="Left"
                      Content="{Binding RetryLabel}"
                      Command="{Binding RetryCommand}" />
            </StackPanel>

            <!-- A reading that carried no figure at all says so, rather than showing nothing. -->
            <TextBlock Grid.Row="1"
                       Grid.Column="1"
                       Margin="12,2,0,0"
                       IsVisible="{Binding ShowsNoFiguresNotice}"
                       Theme="{DynamicResource AltimBodyText}"
                       Foreground="{DynamicResource AltimTextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Text="{Binding NoMetricsText}" />

          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Separator />

    <!-- Resets: one line per provider, carrying the soonest window it reports. -->
    <StackPanel Margin="{DynamicResource AltimInset16}" Spacing="{DynamicResource AltimSpace8}">
      <TextBlock Theme="{DynamicResource AltimLabelText}" Text="{Binding ResetsLabel}" />

      <TextBlock IsVisible="{Binding !HasResets}"
                 Theme="{DynamicResource AltimBodyText}"
                 Foreground="{DynamicResource AltimTextSecondaryBrush}"
                 Text="{Binding NoResetsText}" />

      <ItemsControl IsVisible="{Binding HasResets}" ItemsSource="{Binding Resets}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="{DynamicResource AltimSpace4}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ResetRowViewModel">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource AltimSpace6}">
              <TextBlock Theme="{DynamicResource AltimBodyMetricText}"
                         FontWeight="{DynamicResource AltimFontWeightHeading}"
                         Text="{Binding RemainingText}" />
              <TextBlock VerticalAlignment="Center"
                         Theme="{DynamicResource AltimLabelText}"
                         Text="{Binding ProviderLabel}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <Separator />

    <!-- Status -->
    <StackPanel Margin="{DynamicResource AltimInset16}"
                Orientation="Horizontal"
                Spacing="{DynamicResource AltimSpace12}">
      <Panel VerticalAlignment="Center">
        <Ellipse Classes="statusDisc" Classes.error="{Binding StatusIsError}" />
        <Path Classes="statusMark" Classes.error="{Binding StatusIsError}" />
      </Panel>
      <TextBlock VerticalAlignment="Center"
                 Theme="{DynamicResource AltimBodyText}"
                 TextWrapping="Wrap"
                 Text="{Binding StatusLine}" />
    </StackPanel>

    <Separator />

    <!-- Action -->
    <Button Margin="8"
            HorizontalAlignment="Left"
            Theme="{DynamicResource AltimTextButton}"
            Command="{Binding OpenAltimCommand}">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource AltimSpace8}">
        <TextBlock VerticalAlignment="Center" Text="{Binding OpenLabel}" />
        <Path Classes="icon away" />
      </StackPanel>
    </Button>

  </StackPanel>

</UserControl>
