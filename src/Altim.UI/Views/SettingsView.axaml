<!--
  Settings: general, notifications, providers, privacy, about.

  Sections are separated by rules and whitespace, never by boxes. Every control is one the
  design system already themes, and every change saves itself, so there is no apply button to
  place and no dialog to design.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:design="using:Altim.UI.ViewModels.Design"
             xmlns:sys="using:System"
             xmlns:vm="using:Altim.UI.ViewModels"
             x:Class="Altim.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Design.DataContext="{x:Static design:DesignData.Settings}">

  <UserControl.Styles>
    <StyleInclude Source="avares://Altim.UI/Views/Shared.axaml" />
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="{DynamicResource AltimInset32}" Spacing="{DynamicResource AltimSpace24}">

      <TextBlock Theme="{DynamicResource AltimDisplayText}" Text="{Binding Title}" />

      <!--
        The stored settings could not be read. It is a different event from a write that
        failed, it belongs at the head of the page rather than under General because it is
        about every control below it, and it has to say that those controls are showing
        defaults rather than the user's own values. Everything that writes a setting is
        disabled underneath it: the page cannot save what it never read without saving
        defaults over it.
      -->
      <TextBlock IsVisible="{Binding LoadFailed}"
                 Theme="{DynamicResource AltimBodyText}"
                 Foreground="{DynamicResource AltimStatusErrorBrush}"
                 TextWrapping="Wrap"
                 Text="{Binding LoadFailedText}" />

      <!-- General -->
      <StackPanel IsEnabled="{Binding CanEditSettings}" Spacing="{DynamicResource AltimSpace12}">
        <TextBlock Theme="{DynamicResource AltimHeadingText}" Text="{Binding GeneralHeading}" />

        <ToggleSwitch Content="Launch at login" IsChecked="{Binding LaunchAtLogin}" />
        <ToggleSwitch Content="Start minimised" IsChecked="{Binding StartMinimised}" />

        <Grid ColumnDefinitions="*,Auto" MinHeight="{DynamicResource AltimRowMinHeight}">
          <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Theme" />
          <ComboBox Grid.Column="1"
                    MinWidth="140"
                    ItemsSource="{Binding Themes}"
                    SelectedItem="{Binding SelectedTheme}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ThemeOption">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <Grid ColumnDefinitions="*,Auto" MinHeight="{DynamicResource AltimRowMinHeight}">
          <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Refresh" />
          <ComboBox Grid.Column="1"
                    MinWidth="140"
                    ItemsSource="{Binding RefreshOptions}"
                    SelectedItem="{Binding SelectedRefresh}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:RefreshOption">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <TextBlock IsVisible="{Binding SaveFailed}"
                   Theme="{DynamicResource AltimCaptionText}"
                   Foreground="{DynamicResource AltimStatusErrorBrush}"
                   Text="{Binding SaveFailedText}" />
      </StackPanel>

      <Separator />

      <!-- Notifications -->
      <StackPanel IsEnabled="{Binding CanEditSettings}" Spacing="{DynamicResource AltimSpace12}">
        <TextBlock Theme="{DynamicResource AltimHeadingText}" Text="{Binding NotificationsHeading}" />

        <ToggleSwitch Content="Enable notifications" IsChecked="{Binding NotificationsEnabled}" />

        <Grid ColumnDefinitions="*,Auto" MinHeight="{DynamicResource AltimRowMinHeight}">
          <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Session threshold" />
          <ComboBox Grid.Column="1"
                    MinWidth="140"
                    IsEnabled="{Binding NotificationsEnabled}"
                    ItemsSource="{Binding ThresholdOptions}"
                    SelectedItem="{Binding SelectedSessionThreshold}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ThresholdOption">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <Grid ColumnDefinitions="*,Auto" MinHeight="{DynamicResource AltimRowMinHeight}">
          <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Weekly threshold" />
          <ComboBox Grid.Column="1"
                    MinWidth="140"
                    IsEnabled="{Binding NotificationsEnabled}"
                    ItemsSource="{Binding ThresholdOptions}"
                    SelectedItem="{Binding SelectedWeeklyThreshold}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ThresholdOption">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <ToggleSwitch Content="Reset alerts"
                      IsEnabled="{Binding NotificationsEnabled}"
                      IsChecked="{Binding ResetAlertsEnabled}" />
      </StackPanel>

      <Separator />

      <!-- Providers -->
      <StackPanel Spacing="{DynamicResource AltimSpace12}">
        <TextBlock Theme="{DynamicResource AltimHeadingText}" Text="{Binding ProvidersHeading}" />

        <!--
          The one setting that changes what leaves the machine, so it says who is contacted
          and with whose credentials rather than "allow network calls". Switching it off
          turns the notice on, in the same words the provider page uses.
        -->
        <StackPanel IsEnabled="{Binding CanEditSettings}" Spacing="{DynamicResource AltimSpace4}">
          <ToggleSwitch Content="{Binding AllowNetworkCallsLabel}" IsChecked="{Binding AllowNetworkCalls}" />
          <TextBlock Theme="{DynamicResource AltimCaptionText}"
                     Foreground="{DynamicResource AltimTextSecondaryBrush}"
                     TextWrapping="Wrap"
                     Text="{Binding AllowNetworkCallsDescription}" />
          <TextBlock IsVisible="{Binding ShowsLocalOnlyNotice}"
                     Margin="0,4,0,0"
                     Theme="{DynamicResource AltimCaptionText}"
                     TextWrapping="Wrap"
                     Text="{Binding LocalOnlyNotice}" />
        </StackPanel>

        <!--
          The only switch that writes to a file Altim does not own, so it is off until it is
          asked for, the caption says what is written and that it can be undone, and the
          notice under it carries the three answers that are not yes: no Claude Code here,
          a status line of the user's own in the way, or a settings file that would not be
          read. The switch is disabled for all three, because there is nothing it could do
          about the first two and no way to know what it would be doing about the third.
        -->
        <StackPanel IsEnabled="{Binding CanEditSettings}" Spacing="{DynamicResource AltimSpace4}">
          <ToggleSwitch Content="{Binding ClaudeStatusLineLabel}"
                        IsEnabled="{Binding CanChangeStatusLine}"
                        IsChecked="{Binding ClaudeStatusLineEnabled}" />
          <TextBlock Theme="{DynamicResource AltimCaptionText}"
                     Foreground="{DynamicResource AltimTextSecondaryBrush}"
                     TextWrapping="Wrap"
                     Text="{Binding ClaudeStatusLineDescription}" />
          <TextBlock IsVisible="{Binding ShowsStatusLineNotice}"
                     Margin="0,4,0,0"
                     Theme="{DynamicResource AltimCaptionText}"
                     TextWrapping="Wrap"
                     Text="{Binding StatusLineNotice}" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Providers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ProviderViewModel">
              <Border BorderBrush="{DynamicResource AltimSeparatorBrush}"
                      BorderThickness="{DynamicResource AltimBorderThicknessBottom}"
                      Padding="0,12">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                  <Path Grid.Column="0"
                        Classes="glyph"
                        Classes.anthropic="{Binding IsAnthropic}"
                        Classes.openai="{Binding IsOpenAI}"
                        Classes.gemini="{Binding IsGemini}" />
                  <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="{DynamicResource AltimSpace2}">
                    <TextBlock Theme="{DynamicResource AltimBodyText}" Text="{Binding DisplayName}" />
                    <TextBlock Theme="{DynamicResource AltimCaptionText}"
                               TextWrapping="Wrap"
                               Text="{Binding IntegrationText}" />
                  </StackPanel>
                  <TextBlock Grid.Column="2"
                             VerticalAlignment="Center"
                             Margin="16,0,0,0"
                             Theme="{DynamicResource AltimCaptionMetricText}"
                             Text="{Binding LastRefreshedText}" />
                  <StackPanel Grid.Column="3"
                              Orientation="Horizontal"
                              Margin="16,0,0,0"
                              Spacing="{DynamicResource AltimSpace6}"
                              VerticalAlignment="Center">
                    <Ellipse Classes="status"
                             Classes.ok="{Binding Status.IsOk}"
                             Classes.error="{Binding Status.IsError}" />
                    <TextBlock Theme="{DynamicResource AltimLabelText}" Text="{Binding Status.Word}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Separator />

      <!-- Privacy -->
      <StackPanel Spacing="{DynamicResource AltimSpace12}">
        <TextBlock Theme="{DynamicResource AltimHeadingText}" Text="{Binding PrivacyHeading}" />

        <ItemsControl ItemsSource="{Binding PrivacyLines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="sys:String">
              <TextBlock Theme="{DynamicResource AltimBodyText}"
                         Foreground="{DynamicResource AltimTextSecondaryBrush}"
                         TextWrapping="Wrap"
                         Margin="0,0,0,4"
                         Text="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button HorizontalAlignment="Left"
                Theme="{DynamicResource AltimDestructiveButton}"
                Content="{Binding ClearHistoryLabel}"
                Command="{Binding ClearHistoryCommand}" />

        <TextBlock Theme="{DynamicResource AltimCaptionText}" Text="{Binding ClearHistoryResult}" />
      </StackPanel>

      <Separator />

      <!-- About -->
      <StackPanel Spacing="{DynamicResource AltimSpace4}">
        <TextBlock Theme="{DynamicResource AltimHeadingText}" Text="{Binding AboutHeading}" />
        <TextBlock Theme="{DynamicResource AltimBodyText}" Text="{Binding AppName}" />
        <TextBlock Theme="{DynamicResource AltimCaptionMetricText}" Text="{Binding VersionText}" />
        <TextBlock Theme="{DynamicResource AltimCaptionText}" Text="{Binding Website}" />

        <!--
          The only request Altim makes to a server of its own, so the switch sits beside the
          sentence that says what the request carries rather than behind a word like
          "telemetry". The button is not gated on the switch: pressing it is somebody asking
          once, which is a different act from Altim asking daily.
        -->
        <StackPanel Margin="0,12,0,0"
                    IsEnabled="{Binding CanEditSettings}"
                    Spacing="{DynamicResource AltimSpace4}">
          <ToggleSwitch Content="{Binding AutomaticUpdateChecksLabel}"
                        IsChecked="{Binding AutomaticUpdateChecks}" />
          <TextBlock Theme="{DynamicResource AltimCaptionText}"
                     Foreground="{DynamicResource AltimTextSecondaryBrush}"
                     TextWrapping="Wrap"
                     Text="{Binding AutomaticUpdateChecksDescription}" />
        </StackPanel>

        <StackPanel Margin="0,8,0,0"
                    Orientation="Horizontal"
                    Spacing="{DynamicResource AltimSpace12}">
          <Button Content="{Binding CheckForUpdatesLabel}"
                  IsEnabled="{Binding CanCheckForUpdates}"
                  Command="{Binding CheckForUpdatesCommand}" />
          <TextBlock VerticalAlignment="Center"
                     Theme="{DynamicResource AltimCaptionText}"
                     TextWrapping="Wrap"
                     Text="{Binding UpdateStatusText}" />
        </StackPanel>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>

</UserControl>
