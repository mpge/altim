<!--
  Overview: the heading, a card per provider, and the week beside what is running now.

  The heading is an eyebrow, a title and a line. The eyebrow carries the greeting - which is
  the time-sensitive part and the part that repeats - and the title names the page, which is
  what somebody navigating back to it is looking for. The aggregate status sits opposite the
  eyebrow, on the same line, because it is the other thing that is true of the whole page.

  Both rows below are card grids: two columns while there is room for a card of a readable
  width, one column when there is not. The bottom row is given a height because the panels in
  it are windows onto lists that have no natural end - a week of history and however many
  agents happen to be running - and a panel that grew with its contents would push the cards
  above it off the top of the page.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Altim.UI.Controls"
             xmlns:design="using:Altim.UI.ViewModels.Design"
             xmlns:views="using:Altim.UI.Views"
             xmlns:vm="using:Altim.UI.ViewModels"
             x:Class="Altim.UI.Views.OverviewView"
             x:DataType="vm:OverviewViewModel"
             Design.DataContext="{x:Static design:DesignData.Overview}">

  <UserControl.Styles>
    <StyleInclude Source="avares://Altim.UI/Views/Shared.axaml" />
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="{DynamicResource AltimInset32}" Spacing="{DynamicResource AltimSpace24}">

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="{DynamicResource AltimSpace8}">
          <TextBlock Theme="{DynamicResource AltimEyebrowText}" Text="{Binding EyebrowText}" />
          <TextBlock Theme="{DynamicResource AltimDisplayText}" Text="{Binding PageTitle}" />
          <TextBlock Theme="{DynamicResource AltimLeadText}"
                     TextWrapping="Wrap"
                     Text="{Binding SubHeading}" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Top"
                    Spacing="{DynamicResource AltimSpace8}">
          <Ellipse Classes="status"
                   Classes.ok="{Binding StatusIsOk}"
                   Classes.error="{Binding StatusIsError}" />
          <TextBlock VerticalAlignment="Center"
                     Theme="{DynamicResource AltimBodyText}"
                     Text="{Binding StatusLine}" />
        </StackPanel>
      </Grid>

      <!-- A card for each provider this machine actually has. One that is settled as not
           installed has no card, because a card for it is a name and a sentence saying
           nothing was reported; one whose reading failed keeps its card, because that card
           is the sentence and the Retry. The status line opposite the heading still speaks
           for every provider. -->
      <TextBlock IsVisible="{Binding !HasVisibleProviders}"
                 Theme="{DynamicResource AltimBodyText}"
                 Text="{Binding NoProvidersText}" />

      <ItemsControl ItemsSource="{Binding VisibleProviders}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <controls:CardGrid MinimumColumnWidth="{DynamicResource AltimCardMinWidth}"
                               ColumnGap="{DynamicResource AltimSpace24}"
                               RowGap="{DynamicResource AltimSpace24}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ProviderViewModel">
            <views:ProviderCardView />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <controls:CardGrid MinimumColumnWidth="{DynamicResource AltimCardMinWidth}"
                         ColumnGap="{DynamicResource AltimSpace24}"
                         RowGap="{DynamicResource AltimSpace24}">
        <views:UsageHistoryPanelView Height="248" DataContext="{Binding UsageHistory}" />
        <views:AgentActivityPanelView Height="248" />
      </controls:CardGrid>

    </StackPanel>
  </ScrollViewer>

</UserControl>
