<!--
  History: a year of daily usage as a calendar, and one line per provider over 24 hours,
  7 days or 30 days beneath it.

  The two answer different questions and are kept apart for that reason. The map answers how
  much and when, over a year, one square to a day; the tape answers what a level did inside a
  day or a month, and keeps its range picker. The picker moves the tape only - the map's span
  is always the year behind today.

  The map fills the panel and is scrolled sideways rather than squeezed. A year is fifty three
  week columns: given room they share it out and a day grows with the panel, and given less
  than they need they stop at the smallest square worth drawing and the panel scrolls, because
  a column that shrank to fit a narrow window would take the squares with it until a day was a
  smudge.

  The map is told how wide the panel is through MinWidth, because a horizontally scrolling
  parent offers its content infinity rather than a width - that is what lets the content be
  wider than the viewport - and a year of columns cannot be shared out of infinity. MinWidth
  states the viewport without capping it, so the grid fills the panel when there is room and
  still overflows into a scrollbar when there is not.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Altim.UI.Controls"
             xmlns:design="using:Altim.UI.ViewModels.Design"
             xmlns:views="using:Altim.UI.Views"
             xmlns:vm="using:Altim.UI.ViewModels"
             x:Class="Altim.UI.Views.HistoryView"
             x:DataType="vm:HistoryViewModel"
             Design.DataContext="{x:Static design:DesignData.History}">

  <UserControl.Styles>
    <StyleInclude Source="avares://Altim.UI/Views/Shared.axaml" />
  </UserControl.Styles>

  <!-- The page scrolls, as Overview and Settings do. It did not, and could not: the root was
       a Grid, so everything past the window's bottom edge was simply unreachable. The map
       used to be short enough to hide that. Sharing the panel's width out among a year of
       columns made the squares bigger and the blocks taller, and the tape below went off the
       bottom with no way to reach it. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="{DynamicResource AltimInset32}"
                Spacing="{DynamicResource AltimSpace24}">

    <StackPanel Spacing="{DynamicResource AltimSpace8}">
      <TextBlock Theme="{DynamicResource AltimDisplayText}" Text="{Binding Title}" />
      <TextBlock Theme="{DynamicResource AltimLeadText}"
                 TextWrapping="Wrap"
                 Text="{Binding SubHeading}" />
    </StackPanel>

    <Border Theme="{DynamicResource AltimPanel}">
      <StackPanel Spacing="{DynamicResource AltimSpace16}">
        <TextBlock Theme="{DynamicResource AltimHeadingText}" Text="{Binding Map.PanelTitle}" />

        <!-- The map is handed the one scale the whole page is ranked on. Left to rank itself
             it would rank each map it is given on its own, and a square in one row would stop
             meaning the same thing as a square in another. -->
        <ScrollViewer x:Name="MapScroller"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
          <controls:UsageMap Rows="{Binding Map.Rows}"
                             Scale="{Binding Map.Scale}"
                             EmptyText="{Binding Map.EmptyText}"
                             MinWidth="{Binding #MapScroller.Viewport.Width}" />
        </ScrollViewer>
      </StackPanel>
    </Border>

    <views:UsageHistoryPanelView MinHeight="280" />

    </StackPanel>
  </ScrollViewer>

</UserControl>
