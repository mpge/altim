<!--
  History: one line per provider over 24 hours, 7 days or 30 days.

  The page is the heading and the same panel Overview carries, at full width and full height.
  Two surfaces drawing the same thing two different ways would be two things to learn, so the
  panel is one view used twice and the page only decides how much room it gets.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:design="using:Altim.UI.ViewModels.Design"
             xmlns:views="using:Altim.UI.Views"
             xmlns:vm="using:Altim.UI.ViewModels"
             x:Class="Altim.UI.Views.HistoryView"
             x:DataType="vm:HistoryViewModel"
             Design.DataContext="{x:Static design:DesignData.History}">

  <UserControl.Styles>
    <StyleInclude Source="avares://Altim.UI/Views/Shared.axaml" />
  </UserControl.Styles>

  <Grid Margin="{DynamicResource AltimInset32}" RowDefinitions="Auto,*">

    <StackPanel Grid.Row="0"
                Margin="0,0,0,24"
                Spacing="{DynamicResource AltimSpace8}">
      <TextBlock Theme="{DynamicResource AltimDisplayText}" Text="{Binding Title}" />
      <TextBlock Theme="{DynamicResource AltimLeadText}"
                 TextWrapping="Wrap"
                 Text="{Binding SubHeading}" />
    </StackPanel>

    <views:UsageHistoryPanelView Grid.Row="1" MinHeight="280" />

  </Grid>

</UserControl>
