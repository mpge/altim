<!--
  One provider, as Overview shows it.

  The card is the panel shape doing the Overview's job: 1px border, radius 12, padding 24, no
  shadow. Inside it, a header, the metrics the provider reports, and a footer split by a
  vertical hairline into what happens next and how this window compares with the last one.

  The card is headed by a dial carrying the window nearest its ceiling - the one that decides
  whether this provider can keep working - with the rest of its windows as rows beneath. It is
  the control the tray panel is headed by, unchanged: the same 144 face, the same scale, the
  same tokens. That is what lets two cards side by side be read against one another. Two dials
  of one size on one scale are two readings of one instrument and their sweeps end at comparable
  angles; two of different sizes are two pictures, which is the whole reason a gauge is said not
  to compare.

  The window is named inside the arc's own opening. The sweep is 240 and leaves 120 open at the
  foot, which is where DESIGN.md puts the words under the figure, and a card has one line to put
  there where the panel has two. The name is load-bearing rather than decoration: two cards'
  dials can be carrying different windows, and then the two sweeps are not comparable at all -
  the name is the only thing that says so.

  The provider is not named there. The card header has already said it, four lines up, and
  repeating it under every dial would be the noisiest possible way to say what the card's own
  border already says. It is in the dial's accessible name instead, which is what somebody
  arriving at the dial alone hears.

  The figure inside the face is not announced separately. It is the dial's own reading, which
  the dial's peer already reads out, so it is Raw in the automation tree: without that a screen
  reader says the percentage twice, once as the dial and once as the text standing in it.

  The rest of the metrics are all one figure size, and so is the figure inside the dial. The
  rest of the system gives the first metric on a surface the large figure and the others the
  small one, so the percentage stays the largest thing on screen; on a card the figures are a
  set to be read against one another, and two sizes would say one of them mattered more than
  the other. The dial is what marks the head window, not a bigger number - which also keeps the
  figure at the size it was sized against, because 100% at Figure is what makes the face 144.

  The dial's own reset is not printed under it the way the tray panel prints it. A card reports
  one reset - the soonest window's, in the footer - and on almost every reading that is the
  window on the dial, so a second line would be the same time twice on one card.

  The card carries no per-metric token line. The reference sets one under each metric, reading
  used against limit - Altim's providers report tokens per provider rather than per window and
  no provider reports a token limit at all, so there is no such pair to print. The one token
  count that is reported sits under the metrics as the card's own caption.

  The footer is pushed to the foot of the card rather than following the metrics, because the
  cards in a row are arranged at the row's height and a provider that reports two windows
  would otherwise put its footer half a card higher than the one beside it reporting three.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Altim.UI.Controls"
             xmlns:design="using:Altim.UI.ViewModels.Design"
             xmlns:vm="using:Altim.UI.ViewModels"
             x:Class="Altim.UI.Views.ProviderCardView"
             x:DataType="vm:ProviderViewModel"
             Design.DataContext="{x:Static design:DesignData.Provider}">

  <UserControl.Styles>
    <StyleInclude Source="avares://Altim.UI/Views/Shared.axaml" />
  </UserControl.Styles>

  <Border Theme="{DynamicResource AltimProviderCard}">
    <Grid RowDefinitions="Auto,*,Auto">
    <StackPanel Grid.Row="0" Spacing="{DynamicResource AltimSpace16}">

      <!-- Header -->
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
        <Path Grid.Column="0"
              Classes="glyph large"
              Classes.anthropic="{Binding IsAnthropic}"
              Classes.openai="{Binding IsOpenAI}"
              Classes.gemini="{Binding IsGemini}" />
        <TextBlock Grid.Column="1"
                   Margin="12,0,0,0"
                   VerticalAlignment="Center"
                   Theme="{DynamicResource AltimSubheadText}"
                   Text="{Binding DisplayName}" />
        <Button Grid.Column="2"
                Margin="2,0,0,0"
                VerticalAlignment="Center"
                Theme="{DynamicResource AltimIconButton}"
                AutomationProperties.Name="{Binding DisclosureLabel}"
                Command="{Binding OpenCommand}">
          <Path Classes="icon next quiet" />
        </Button>
        <Ellipse Grid.Column="4"
                 Classes="status"
                 Classes.ok="{Binding Status.IsOk}"
                 Classes.error="{Binding Status.IsError}" />
        <TextBlock Grid.Column="5"
                   Margin="6,0,0,0"
                   VerticalAlignment="Center"
                   Theme="{DynamicResource AltimLabelText}"
                   Text="{Binding Status.Word}" />
      </Grid>

      <!-- A failed reading: the sentence and the one action that can change it. -->
      <StackPanel IsVisible="{Binding HasError}" Spacing="{DynamicResource AltimSpace12}">
        <TextBlock Theme="{DynamicResource AltimBodyText}" Text="{Binding ErrorText}" />
        <Button HorizontalAlignment="Left"
                Content="{Binding RetryLabel}"
                Command="{Binding RetryCommand}" />
      </StackPanel>

      <!-- Nothing has been read from this provider yet. That is not the same thing as a
           provider that answered and reported nothing, and the card used to say the second
           from the moment it was built until the first reading landed. -->
      <TextBlock IsVisible="{Binding ShowsWaitingNotice}"
                 Theme="{DynamicResource AltimBodyText}"
                 Foreground="{DynamicResource AltimTextSecondaryBrush}"
                 Text="{Binding WaitingText}" />

      <!-- A reading that carried no metric at all says so, rather than showing nothing. -->
      <TextBlock IsVisible="{Binding ShowsNoMetricsNotice}"
                 Theme="{DynamicResource AltimBodyText}"
                 Foreground="{DynamicResource AltimTextSecondaryBrush}"
                 Text="{Binding NoMetricsText}" />

      <!-- The head: the window nearest its ceiling, on the dial. The figure and the window's
           name are the view's own text blocks rather than something the control draws, so they
           take the type scale and the design system's tabular numerals; both stand inside the
           face, so the whole head is the dial's own 144 square. -->
      <Panel IsVisible="{Binding HasHeadline}" HorizontalAlignment="Center">
        <controls:Dial Value="{Binding Headline.Value}"
                       Threshold="{Binding Headline.Threshold}"
                       AutomationProperties.Name="{Binding Headline.SourceLabel}" />

        <!-- Inside the face. The dial's band is 14 deep and the clear circle inside it is
             116 across, which is what the face was sized against. -->
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   AutomationProperties.AccessibilityView="Raw"
                   Classes="figure primary"
                   Text="{Binding Headline.PercentText}" />

        <!-- In the 120 the sweep leaves open at the foot. Standing it under the face instead
             puts it 44 below the last ink of the dial it names and 16 above the first row
             beneath, which reads as a heading for the rows. -->
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Theme="{DynamicResource AltimLeadMediumText}"
                   Classes.warn="{Binding Headline.IsAboveThreshold}"
                   Text="{Binding Headline.WindowLabel}" />
      </Panel>

      <!-- The rule the tray panel draws under its own reading, doing the same job: the head
           reading is one section and the windows under it are another. It is also the one
           line that runs the card's full width at the same height on every card in the row,
           which is what stops a dial floating in a card rather than heading one. -->
      <Separator IsVisible="{Binding HasHeadline}" />

      <ItemsControl ItemsSource="{Binding RemainingMetrics}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="{DynamicResource AltimSpace16}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:MetricViewModel">
            <StackPanel Spacing="{DynamicResource AltimSpace6}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Bottom"
                           Theme="{DynamicResource AltimLeadMediumText}"
                           Classes.warn="{Binding IsAboveThreshold}"
                           Text="{Binding Label}" />
                <TextBlock Grid.Column="1"
                           Classes="figure primary"
                           IsVisible="{Binding IsReported}"
                           VerticalAlignment="Bottom"
                           Text="{Binding PercentText}" />
                <TextBlock Grid.Column="1"
                           Theme="{DynamicResource AltimCaptionText}"
                           IsVisible="{Binding !IsReported}"
                           VerticalAlignment="Bottom"
                           TextAlignment="Right"
                           TextWrapping="Wrap"
                           MaxWidth="160"
                           Text="{Binding UnavailableText}" />
              </Grid>
              <controls:Meter Value="{Binding Value}" Threshold="{Binding Threshold}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock IsVisible="{Binding HasTokens}"
                 Theme="{DynamicResource AltimCaptionMetricText}"
                 Text="{Binding TokensText}" />

    </StackPanel>

    <StackPanel Grid.Row="2" Spacing="{DynamicResource AltimSpace16}" Margin="0,16,0,0">

      <Separator />

      <!-- Footer: what happens next, how this window compares, and when the reading was
           taken. The hairline between the first two is vertical, and the last sits at the
           far end of the same row rather than on a line of its own. -->
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
        <StackPanel Grid.Column="0" Spacing="{DynamicResource AltimSpace4}">
          <TextBlock Theme="{DynamicResource AltimLabelText}" Text="{Binding ResetsLabel}" />
          <TextBlock Theme="{DynamicResource AltimFigureSmallText}" Text="{Binding ResetRemainingText}" />
        </StackPanel>

        <Separator Grid.Column="1"
                   Margin="24,0"
                   Theme="{DynamicResource AltimVerticalSeparator}" />

        <StackPanel Grid.Column="2" Spacing="{DynamicResource AltimSpace4}">
          <TextBlock Theme="{DynamicResource AltimLabelText}" Text="{Binding PacingLabel}" />
          <TextBlock Classes="pacing"
                     Classes.better="{Binding IsPacingBetter}"
                     Theme="{DynamicResource AltimFigureSmallText}"
                     Text="{Binding PacingText}" />
          <TextBlock Theme="{DynamicResource AltimCaptionText}"
                     IsVisible="{Binding HasPacingCaption}"
                     Text="{Binding PacingCaption}" />
        </StackPanel>

        <TextBlock Grid.Column="4"
                   VerticalAlignment="Bottom"
                   Theme="{DynamicResource AltimCaptionMetricText}"
                   Text="{Binding LastRefreshedText}" />
      </Grid>

    </StackPanel>
    </Grid>
  </Border>

</UserControl>
