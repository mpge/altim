<!--
  The handful of styles the views share.

  Most of them exist because a colour cannot be bound: every brush in Altim lives in a theme
  dictionary and is resolved per variant, so a view model that handed a view a brush would hand
  it a brush from the wrong theme the moment the system switched. Instead the view model exposes
  booleans, the view turns them into style classes, and the class picks the brush with
  DynamicResource, which keeps following the variant.

  Nothing here restyles a control. Every ControlTheme still comes from Themes/.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fmt="using:Altim.UI.Formatting">

  <!-- The path data arrives here rather than through a binding, and that is not a detail.
       A Geometry cannot be built until Avalonia's rendering platform exists, so a view model
       that held one could not be constructed by a unit test, or by anything else that runs
       before a window does - and because the failure happens inside a type initialiser, the
       first such touch poisons the type for the rest of the process. A style is applied to a
       control that is already in a visual tree, which is exactly when the platform is up. -->

  <!-- The provider mark. Default is the neutral face; the accent classes are the only
       place a provider accent appears. Three sizes, one job: 16 beside a label, 20 in an
       activity row, 28 where a provider heads a card or a panel row. The geometry is
       authored on the 16px box and stretched, so one path serves all three. -->
  <Style Selector="Path.glyph">
    <Setter Property="Width" Value="{DynamicResource AltimProviderGlyphSize}" />
    <Setter Property="Height" Value="{DynamicResource AltimProviderGlyphSize}" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{DynamicResource AltimTextSecondaryBrush}" />
    <Setter Property="Data" Value="{x:Static fmt:ProviderIdentity.Circle}" />
  </Style>

  <Style Selector="Path.glyph.medium">
    <Setter Property="Width" Value="{DynamicResource AltimProviderGlyphSizeMedium}" />
    <Setter Property="Height" Value="{DynamicResource AltimProviderGlyphSizeMedium}" />
  </Style>

  <Style Selector="Path.glyph.large">
    <Setter Property="Width" Value="{DynamicResource AltimProviderGlyphSizeLarge}" />
    <Setter Property="Height" Value="{DynamicResource AltimProviderGlyphSizeLarge}" />
  </Style>

  <Style Selector="Path.glyph.anthropic">
    <Setter Property="Fill" Value="{DynamicResource AltimAccentAnthropicBrush}" />
    <Setter Property="Data" Value="{x:Static fmt:ProviderIdentity.AnthropicMark}" />
  </Style>

  <Style Selector="Path.glyph.openai">
    <Setter Property="Fill" Value="{DynamicResource AltimAccentOpenAIBrush}" />
    <Setter Property="Data" Value="{x:Static fmt:ProviderIdentity.OpenAIMark}" />
  </Style>

  <!-- A line icon: the same 16px box, stroked rather than filled, in the ink of the
       surface it stands on. The quiet class is for an icon inside a control whose label
       is already carrying the meaning, such as a drop down's chevron. -->
  <Style Selector="Path.icon">
    <Setter Property="Width" Value="{DynamicResource AltimIconSize}" />
    <Setter Property="Height" Value="{DynamicResource AltimIconSize}" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Stroke" Value="{DynamicResource AltimTextPrimaryBrush}" />
    <Setter Property="StrokeThickness" Value="{DynamicResource AltimIconStrokeThickness}" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="StrokeLineCap" Value="Round" />
  </Style>

  <Style Selector="Path.icon.quiet">
    <Setter Property="Stroke" Value="{DynamicResource AltimTextSecondaryBrush}" />
  </Style>

  <Style Selector="Path.icon.home">
    <Setter Property="Data" Value="{x:Static fmt:AltimIcons.Home}" />
  </Style>

  <Style Selector="Path.icon.clock">
    <Setter Property="Data" Value="{x:Static fmt:AltimIcons.Clock}" />
  </Style>

  <Style Selector="Path.icon.gear">
    <Setter Property="Data" Value="{x:Static fmt:AltimIcons.Settings}" />
  </Style>

  <Style Selector="Path.icon.next">
    <Setter Property="Data" Value="{x:Static fmt:AltimIcons.ChevronRight}" />
  </Style>

  <Style Selector="Path.icon.down">
    <Setter Property="Data" Value="{x:Static fmt:AltimIcons.ChevronDown}" />
  </Style>

  <Style Selector="Path.icon.away">
    <Setter Property="Data" Value="{x:Static fmt:AltimIcons.ArrowRight}" />
  </Style>

  <!-- The 6px status dot. Neutral by default: DESIGN.md gives status three colours, and a
       state that is neither healthy nor unreachable is not one of them. -->
  <Style Selector="Ellipse.status">
    <Setter Property="Theme" Value="{DynamicResource AltimStatusDot}" />
    <Setter Property="Fill" Value="{DynamicResource AltimTextSecondaryBrush}" />
  </Style>

  <!-- The larger form, for a row where the dot is the only thing carrying the state. -->
  <Style Selector="Ellipse.status.large">
    <Setter Property="Width" Value="{DynamicResource AltimLegendDotSize}" />
    <Setter Property="Height" Value="{DynamicResource AltimLegendDotSize}" />
  </Style>

  <Style Selector="Ellipse.status.ok">
    <Setter Property="Fill" Value="{DynamicResource AltimStatusOkBrush}" />
  </Style>

  <Style Selector="Ellipse.status.error">
    <Setter Property="Fill" Value="{DynamicResource AltimStatusErrorBrush}" />
  </Style>

  <!-- The legend dot names a line on the tape, so it takes the line's own weight rather
       than a status colour: the tape has two weights and the legend has two dots. -->
  <Style Selector="Ellipse.legend">
    <Setter Property="Theme" Value="{DynamicResource AltimLegendDot}" />
  </Style>

  <Style Selector="Ellipse.legend.secondary">
    <Setter Property="Fill" Value="{DynamicResource AltimChartLineSecondaryBrush}" />
  </Style>

  <!-- The dial's legend mark: the ring it names, at the ring's own place in the stack. It
       is an outline rather than a disc because the thing it stands for is a ring, and its
       diameter rather than its colour is what ties it to an arc - two providers can easily be
       in the same band, and a size survives having the colour taken away. The ink is the
       engraving's, because the mark belongs to the instrument rather than to the reading. -->
  <Style Selector="Ellipse.dialRing">
    <Setter Property="Fill" Value="{x:Null}" />
    <Setter Property="Stroke" Value="{DynamicResource AltimMeterScaleBrush}" />
    <Setter Property="StrokeThickness" Value="{DynamicResource AltimHairline}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- The panel's status icon: a filled disc with the mark cut through it in the ground
       colour. The disc is ink when everything answered and StatusError when something did
       not, which is status appearing as colour on a mark rather than as a tinted panel. -->
  <Style Selector="Ellipse.statusDisc">
    <Setter Property="Width" Value="{DynamicResource AltimStatusIconSize}" />
    <Setter Property="Height" Value="{DynamicResource AltimStatusIconSize}" />
    <Setter Property="Fill" Value="{DynamicResource AltimTextPrimaryBrush}" />
  </Style>

  <Style Selector="Ellipse.statusDisc.error">
    <Setter Property="Fill" Value="{DynamicResource AltimStatusErrorBrush}" />
  </Style>

  <Style Selector="Path.statusMark">
    <Setter Property="Data" Value="{x:Static fmt:AltimIcons.Check}" />
    <Setter Property="Width" Value="{DynamicResource AltimSpace12}" />
    <Setter Property="Height" Value="{DynamicResource AltimSpace12}" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Stroke" Value="{DynamicResource AltimSurfaceBrush}" />
    <Setter Property="StrokeThickness" Value="{DynamicResource AltimIconStrokeThickness}" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="StrokeLineCap" Value="Round" />
  </Style>

  <Style Selector="Path.statusMark.error">
    <Setter Property="Data" Value="{x:Static fmt:AltimIcons.Alert}" />
  </Style>

  <!-- A metric figure. The first metric on a surface carries the large figure and the rest the
       small one, so the percentage stays the largest thing on screen without repeating itself.
       A provider card is the exception the reference sets: its metrics are a set to be read
       against one another, so they are all one size. -->
  <Style Selector="TextBlock.figure">
    <Setter Property="Theme" Value="{DynamicResource AltimFigureSmallText}" />
  </Style>

  <Style Selector="TextBlock.figure.primary">
    <Setter Property="Theme" Value="{DynamicResource AltimFigureText}" />
  </Style>

  <!-- Above the threshold the label turns, never the meter fill. -->
  <Style Selector="TextBlock.warn">
    <Setter Property="Foreground" Value="{DynamicResource AltimStatusWarnBrush}" />
  </Style>

  <!-- Pacing under the previous window is the one piece of good news the interface has to
       report, and it reports it the way it reports every other status: as colour on a word. -->
  <Style Selector="TextBlock.pacing.better">
    <Setter Property="Foreground" Value="{DynamicResource AltimStatusOkBrush}" />
  </Style>

</Styles>
