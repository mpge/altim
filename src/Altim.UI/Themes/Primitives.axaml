<!--
  Altim primitives: everything in docs/DESIGN.md that does not change with the theme
  variant. Spacing, radii, line weights, the type scale and the two motion durations.

  These live outside ThemeDictionaries deliberately, so they resolve identically in
  Light and Dark. They are still safe to consume with DynamicResource, and control
  themes here do exactly that so that one lookup rule applies across the whole system.

  Nothing in between the scale steps exists. If a view needs a value that is not here,
  the value belongs in DESIGN.md first.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ==================================================================== -->
  <!-- Spacing scale: 2 4 6 8 12 16 20 24 32 48. Nothing in between.        -->
  <!-- ==================================================================== -->
  <x:Double x:Key="AltimSpace2">2</x:Double>
  <x:Double x:Key="AltimSpace4">4</x:Double>
  <x:Double x:Key="AltimSpace6">6</x:Double>
  <x:Double x:Key="AltimSpace8">8</x:Double>
  <x:Double x:Key="AltimSpace12">12</x:Double>
  <x:Double x:Key="AltimSpace16">16</x:Double>
  <x:Double x:Key="AltimSpace20">20</x:Double>
  <x:Double x:Key="AltimSpace24">24</x:Double>
  <x:Double x:Key="AltimSpace32">32</x:Double>
  <x:Double x:Key="AltimSpace48">48</x:Double>

  <!-- The same scale as uniform Thickness values, for Margin and Padding. -->
  <Thickness x:Key="AltimInset2">2</Thickness>
  <Thickness x:Key="AltimInset4">4</Thickness>
  <Thickness x:Key="AltimInset6">6</Thickness>
  <Thickness x:Key="AltimInset8">8</Thickness>
  <Thickness x:Key="AltimInset12">12</Thickness>
  <Thickness x:Key="AltimInset16">16</Thickness>
  <Thickness x:Key="AltimInset20">20</Thickness>
  <Thickness x:Key="AltimInset24">24</Thickness>
  <Thickness x:Key="AltimInset32">32</Thickness>
  <Thickness x:Key="AltimInset48">48</Thickness>

  <!-- ==================================================================== -->
  <!-- Radius: 4 for chips and meter ends, 6 for controls, 8 for rows and   -->
  <!-- drop downs, 12 for cards, panels and the popup. Nothing else.        -->
  <!-- ==================================================================== -->
  <x:Double x:Key="AltimRadius4">4</x:Double>
  <x:Double x:Key="AltimRadius6">6</x:Double>
  <x:Double x:Key="AltimRadius8">8</x:Double>
  <x:Double x:Key="AltimRadius12">12</x:Double>
  <CornerRadius x:Key="AltimCornerRadius4">4</CornerRadius>
  <CornerRadius x:Key="AltimCornerRadius6">6</CornerRadius>
  <CornerRadius x:Key="AltimCornerRadius8">8</CornerRadius>
  <CornerRadius x:Key="AltimCornerRadius12">12</CornerRadius>

  <!-- ==================================================================== -->
  <!-- Line: borders are exactly 1px, separators are 1px with no margin.    -->
  <!-- ==================================================================== -->
  <x:Double x:Key="AltimHairline">1</x:Double>
  <Thickness x:Key="AltimBorderThickness">1</Thickness>
  <Thickness x:Key="AltimBorderThicknessBottom">0,0,0,1</Thickness>
  <Thickness x:Key="AltimBorderThicknessTop">0,1,0,0</Thickness>
  <Thickness x:Key="AltimBorderThicknessRight">0,0,1,0</Thickness>
  <Thickness x:Key="AltimBorderThicknessNone">0</Thickness>

  <!-- Focus: a 2px ring, offset 2px, never removed. The ring is drawn outside the
       control bounds, so its Border sits at -(offset + thickness) = -4.

       A ring drawn outside the bounds only survives if the control does not clip to them.
       TemplatedControl clips by default, so every theme that hosts the ring also sets
       ClipToBounds="False", and sets FocusAdorner="{x:Null}" so the base theme's dashed
       rectangle cannot appear beside it. Both are part of the ring, not decoration. -->
  <x:Double x:Key="AltimFocusRingWidth">2</x:Double>
  <x:Double x:Key="AltimFocusRingOffset">2</x:Double>
  <Thickness x:Key="AltimFocusRingThickness">2</Thickness>
  <Thickness x:Key="AltimFocusRingMargin">-4</Thickness>

  <!-- ==================================================================== -->
  <!-- Hit targets and fixed component sizes.                                -->
  <!-- ==================================================================== -->
  <x:Double x:Key="AltimRowMinHeight">28</x:Double>
  <x:Double x:Key="AltimButtonMinHeight">32</x:Double>
  <x:Double x:Key="AltimControlMinHeight">32</x:Double>
  <x:Double x:Key="AltimSidebarWidth">192</x:Double>
  <x:Double x:Key="AltimSidebarItemHeight">40</x:Double>
  <x:Double x:Key="AltimPopupWidth">320</x:Double>

  <!-- The sidebar's brand header: the mark and the wordmark above the navigation,
       on the same 24px inset the footer block below the navigation uses. -->
  <x:Double x:Key="AltimBrandMarkSize">22</x:Double>
  <x:Double x:Key="AltimBrandHeaderHeight">64</x:Double>

  <!-- The popup's window is wider than its panel by the shadow inset on both sides, and
       taller by the inset above and below: the panel is the 320 DESIGN.md specifies and
       the rest of the window is transparent room for the one shadow to fall into. The
       composition root positions the WINDOW, so it must subtract the inset to line the
       panel up with the tray icon. This is the width for the whole inset; placement trims
       one edge and owns the width while it does. See AltimPopupShadowMargin below. -->
  <x:Double x:Key="AltimPopupWindowWidth">368</x:Double>
  <x:Double x:Key="AltimStatusDotSize">6</x:Double>
  <x:Double x:Key="AltimLegendDotSize">8</x:Double>
  <x:Double x:Key="AltimStatusIconSize">18</x:Double>
  <x:Double x:Key="AltimProviderGlyphSize">16</x:Double>

  <!-- The mark keeps one job at three sizes: 28 where a provider heads a card or a
       panel row, 20 in an activity row, 16 everywhere a mark sits beside a label. -->
  <x:Double x:Key="AltimProviderGlyphSizeMedium">20</x:Double>
  <x:Double x:Key="AltimProviderGlyphSizeLarge">28</x:Double>
  <x:Double x:Key="AltimIconSize">16</x:Double>
  <x:Double x:Key="AltimIconStrokeThickness">1.5</x:Double>
  <!-- The meter is a rail read against a scale: an 8 tall rail, a 2 gap, and a 4 tall
       row of graduations under it. The graduations tighten toward the ceiling, which is
       where a reading starts to matter, and the threshold is an index crossing all 14
       rather than a change of colour. The control owns these numbers - Meter.RailHeight
       and the constants beside it - so a view cannot lose them by not applying a theme;
       these tokens are the design system's copy, and MeterTests fails if the two
       disagree. -->
  <x:Double x:Key="AltimMeterHeight">14</x:Double>
  <x:Double x:Key="AltimMeterRailHeight">8</x:Double>
  <x:Double x:Key="AltimMeterScaleGap">2</x:Double>
  <x:Double x:Key="AltimMeterScaleHeight">4</x:Double>

  <!-- A meter reports a level by its width, so a meter with no width reports nothing. In
       an auto sized column it would measure to zero and vanish, which is why it asks for
       a floor of one spacing step short of the popup's half width. The floor is intrinsic
       to the control - Meter.MinimumWidth - so a view cannot lose it by not applying a
       theme; this token is the design system's copy of that number, and MeterTests fails
       if the two disagree. -->
  <x:Double x:Key="AltimMeterMinWidth">48</x:Double>

  <!-- The dial is the meter's cross section bent round a swept arc: the same 8 rail, 2 gap
       and 4 graduations, rail innermost and engraving outermost, so the whole band is 14 deep
       from the face's edge inward. The face is sized from the figure inside it: "100%" is 95
       wide at Figure and its ink stands 12 either side of the middle, so a 144 face leaves a
       clear circle 116 across and 9 between the figure and the rail at its widest. The sweep
       is 240 degrees centred on the top, so nothing used and the ceiling are two
       distinguishable ends and the 120 degrees left open at the foot carry the words under
       the figure. The control owns these numbers - Dial.Size and Dial.Sweep - so a view
       cannot lose them by not applying a theme; these tokens are the design system's copy,
       and DialTests fails if the two disagree. -->
  <x:Double x:Key="AltimDialSize">144</x:Double>
  <x:Double x:Key="AltimDialSweep">240</x:Double>

  <!-- The box a legend's ring mark stands in. The face carries one sweep per provider on
       concentric rings, and the legend names them with circles that shrink the same way the
       rings do, so "the big circle" and "the outer ring" are the same thing without anybody
       being told the convention. The widest mark is this box; each ring inward is 4 smaller,
       which the control owns as Dial.LegendMarkSize and Dial.LegendMarkStep. DialTests fails
       if this copy and the control's disagree. -->
  <x:Double x:Key="AltimDialLegendMarkSize">14</x:Double>
  <x:Double x:Key="AltimTapeMinHeight">96</x:Double>
  <x:Double x:Key="AltimTapeLineThickness">2</x:Double>
  <x:Double x:Key="AltimTapeDotDiameter">4</x:Double>
  <x:Double x:Key="AltimScrollBarThickness">8</x:Double>

  <!-- DESIGN.md does not specify a toggle. The track is derived from the scale: a 16
       tall pill, a 12 knob, so the travel is one scale step and the width is 16 + 12 = 28.
       The control itself still keeps the 28px row hit target.

       The knob inset is a hairline, not a spacing step, because the track's own 1px border
       already eats one pixel on each side: 16 - (2 x 1 border) - (2 x 1 inset) = 12, the
       knob's own height. At the 2 it used to be the knob measured 10 and sat squashed
       inside a track that was one border too small for it.

       The track radius is half its height so the ends are semicircles. At the control
       radius of 6 a 16 tall track reads as a rounded rectangle, which is not a pill. -->
  <x:Double x:Key="AltimToggleTrackWidth">28</x:Double>
  <x:Double x:Key="AltimToggleTrackHeight">16</x:Double>
  <x:Double x:Key="AltimToggleKnobSize">12</x:Double>
  <Thickness x:Key="AltimToggleKnobInset">1</Thickness>
  <CornerRadius x:Key="AltimToggleTrackRadius">8</CornerRadius>
  <CornerRadius x:Key="AltimToggleKnobRadius">6</CornerRadius>

  <!-- Disabled is expressed as opacity, not as a colour: DESIGN.md has no disabled
       colour, and inventing one would put a value in a view that is not in the doc. -->
  <x:Double x:Key="AltimDisabledOpacity">0.45</x:Double>

  <!-- ==================================================================== -->
  <!-- Component insets. Every number here is a step on the spacing scale.   -->
  <!-- ==================================================================== -->
  <Thickness x:Key="AltimButtonPadding">12,0</Thickness>
  <Thickness x:Key="AltimTextBoxPadding">8,0</Thickness>
  <Thickness x:Key="AltimComboBoxPadding">8,0</Thickness>
  <Thickness x:Key="AltimToolTipPadding">8,6</Thickness>
  <Thickness x:Key="AltimSidebarItemPadding">16,0</Thickness>
  <Thickness x:Key="AltimRowPadding">12,12</Thickness>
  <Thickness x:Key="AltimCardPadding">24</Thickness>
  <Thickness x:Key="AltimChipPadding">8,4</Thickness>

  <!-- A card column narrower than this stops being a card and starts being a list, so
       the card grid drops to one column rather than squeezing two. -->
  <x:Double x:Key="AltimCardMinWidth">320</x:Double>

  <!-- Room for the one shadow, on the one window that casts it. Every side is a step on
       the scale, and the bottom is deeper because the shadow is offset 8 downward.

       This inset is the difference between the window and the panel. The panel is 320
       wide; the window is 320 + 24 + 24 = 368 and starts 16 above the panel's top edge.
       Anything positioning that window against a tray icon must offset by this inset, or
       the transparent margin lines up with the icon and the panel sits 24px off.

       It reaches the panel through PopupChrome.ShadowInset, which the popup window theme
       sets from here. Placement cuts the property back to the 8pt gap on whichever edge
       faces the tray icon, because reserved room is still window and a window over a tray
       icon swallows the clicks meant for it. This stays the design's value: it is what the
       shadow needs, and three of the four edges always get it. -->
  <Thickness x:Key="AltimPopupShadowMargin">24,16,24,32</Thickness>

  <!-- The absence of that shadow, as a token. A style that turns the shadow off has to set
       a value, and an empty string is not one: Avalonia's BoxShadows converter rejects it
       and the whole ControlTheme fails to attach. "none" is the empty BoxShadows. -->
  <BoxShadows x:Key="AltimNoShadow">none</BoxShadows>

  <!-- ==================================================================== -->
  <!-- Type scale. Size / line height / weight / tracking.                   -->
  <!-- Tracking is stated in em in DESIGN.md; Avalonia LetterSpacing is in    -->
  <!-- device independent pixels, so each value is em x size.                -->
  <!-- ==================================================================== -->
  <x:Double x:Key="AltimFontSizeFigure">34</x:Double>
  <x:Double x:Key="AltimLineHeightFigure">36</x:Double>
  <FontWeight x:Key="AltimFontWeightFigure">SemiBold</FontWeight>
  <x:Double x:Key="AltimLetterSpacingFigure">-0.68</x:Double>

  <x:Double x:Key="AltimFontSizeFigureSmall">20</x:Double>
  <x:Double x:Key="AltimLineHeightFigureSmall">24</x:Double>
  <FontWeight x:Key="AltimFontWeightFigureSmall">SemiBold</FontWeight>
  <x:Double x:Key="AltimLetterSpacingFigureSmall">-0.2</x:Double>

  <x:Double x:Key="AltimFontSizeDisplay">40</x:Double>
  <x:Double x:Key="AltimLineHeightDisplay">44</x:Double>
  <FontWeight x:Key="AltimFontWeightDisplay">Bold</FontWeight>
  <x:Double x:Key="AltimLetterSpacingDisplay">-0.8</x:Double>

  <x:Double x:Key="AltimFontSizeTitle">28</x:Double>
  <x:Double x:Key="AltimLineHeightTitle">34</x:Double>
  <FontWeight x:Key="AltimFontWeightTitle">SemiBold</FontWeight>
  <x:Double x:Key="AltimLetterSpacingTitle">-0.56</x:Double>

  <x:Double x:Key="AltimFontSizeSubhead">21</x:Double>
  <x:Double x:Key="AltimLineHeightSubhead">28</x:Double>
  <FontWeight x:Key="AltimFontWeightSubhead">SemiBold</FontWeight>
  <x:Double x:Key="AltimLetterSpacingSubhead">-0.42</x:Double>

  <x:Double x:Key="AltimFontSizeHeading">15</x:Double>
  <x:Double x:Key="AltimLineHeightHeading">20</x:Double>
  <FontWeight x:Key="AltimFontWeightHeading">SemiBold</FontWeight>
  <x:Double x:Key="AltimLetterSpacingHeading">0</x:Double>

  <x:Double x:Key="AltimFontSizeLead">14</x:Double>
  <x:Double x:Key="AltimLineHeightLead">20</x:Double>
  <FontWeight x:Key="AltimFontWeightLead">Normal</FontWeight>
  <FontWeight x:Key="AltimFontWeightLeadMedium">Medium</FontWeight>
  <FontWeight x:Key="AltimFontWeightLeadStrong">SemiBold</FontWeight>
  <x:Double x:Key="AltimLetterSpacingLead">0</x:Double>

  <x:Double x:Key="AltimFontSizeBody">13</x:Double>
  <x:Double x:Key="AltimLineHeightBody">18</x:Double>
  <FontWeight x:Key="AltimFontWeightBody">Normal</FontWeight>
  <x:Double x:Key="AltimLetterSpacingBody">0</x:Double>

  <x:Double x:Key="AltimFontSizeLabel">12</x:Double>
  <x:Double x:Key="AltimLineHeightLabel">16</x:Double>
  <FontWeight x:Key="AltimFontWeightLabel">Medium</FontWeight>
  <x:Double x:Key="AltimLetterSpacingLabel">0</x:Double>

  <x:Double x:Key="AltimFontSizeCaption">11</x:Double>
  <x:Double x:Key="AltimLineHeightCaption">14</x:Double>
  <FontWeight x:Key="AltimFontWeightCaption">Normal</FontWeight>
  <x:Double x:Key="AltimLetterSpacingCaption">0.11</x:Double>

  <!-- The eyebrow is the one place Altim sets capitals, and it is the reference's
       decision rather than this document's first instinct: at 11px, tracked a full
       0.08em open, the caps read as a label for the title rather than as shouting. -->
  <x:Double x:Key="AltimFontSizeEyebrow">11</x:Double>
  <x:Double x:Key="AltimLineHeightEyebrow">14</x:Double>
  <FontWeight x:Key="AltimFontWeightEyebrow">Medium</FontWeight>
  <x:Double x:Key="AltimLetterSpacingEyebrow">0.88</x:Double>

  <!-- ==================================================================== -->
  <!-- Motion. Two durations exist: 120ms and 180ms. Motion happens only in  -->
  <!-- response to something changing.                                       -->
  <!-- ==================================================================== -->
  <x:TimeSpan x:Key="AltimDuration120">00:00:00.1200000</x:TimeSpan>
  <x:TimeSpan x:Key="AltimDuration180">00:00:00.1800000</x:TimeSpan>
  <x:Double x:Key="AltimPopupRiseDistance">4</x:Double>

</ResourceDictionary>
