<!--
  Window, and the popup panel shape.

  The default window is a plain Surface ground carrying the Inter face and Body size, so
  every descendant inherits the family without a view setting it.

  AltimPopupWindow is the tray panel from DESIGN.md: a 320 wide panel, radius 12, 1px border,
  SurfaceMuted, and the single shadow the system allows. The 320 is on the PANEL. The window
  is wider - AltimPopupWindowWidth, 320 plus the shadow inset on both sides - because the
  window is transparent room for the shadow to fall into and the panel is the thing the user
  sees. Positioning code therefore anchors the window, not the panel, and must subtract
  the inset to line the panel up with the tray icon.

  That inset reaches the panel through PopupChrome.ShadowInset rather than straight out of
  AltimPopupShadowMargin, and this theme is what puts the token into it. Placement trims the
  property on whichever edge is currently pointing at the tray icon, because room reserved
  for a shadow is still window, and a window over a tray icon swallows the clicks meant for
  it. Whatever sets the property owns Width with it: PART_PopupPanel is a fixed 320, so a
  window sized for one inset and carrying another centres the panel and misplaces it.

  The panel does not clip to its bounds. A BoxShadow is drawn outside them, so clipping
  erases the one shadow in the system; and since ClipToBounds is a rectangular clip it never
  rounded off the corners it looked like it was there to round off in the first place.

  The panel scrolls. SizeToContent gives it the height its content wants, and the content is
  one provider taller than it was for every provider this machine has: measured, 529 DIPs for
  one, 659 for two, 765 for three. A 1366x768 screen has 728 to give and a 1920x1080 screen at
  175% has 576, so the panel that fits everywhere does not exist and the window has to have a
  ceiling. PopupPlacement.MaxWindowHeight is that ceiling and the composition root puts it on
  Window.MaxHeight; this ScrollViewer is what makes the rest of the panel reachable instead of
  hanging off the bottom of the screen. Where the panel fits - which is most screens, most of
  the time - there is no scrollbar and nothing about the window changes.

  When the compositor gives the window no transparency the inset would render as whatever is
  behind an unpainted surface, which is black. So TransparencyBackgroundFallback is the panel
  ground rather than Transparent: the room reserved for the shadow paints in the panel's own
  colour instead. The shadow itself goes, because there is nothing for it to fall onto, and
  it goes by setting AltimNoShadow rather than an empty string - Avalonia's BoxShadows
  converter rejects "" and the whole ControlTheme then fails to attach.

  The window keeps its width in that state on purpose. ActualTransparencyLevel is not known
  until the window has a platform impl, which is after its first measure, and Avalonia writes
  the client width back to Window.Width as a local value the moment the platform reports a
  size. A style that tried to shrink the window afterwards would be overridden and would read
  as working while doing nothing.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="using:Altim.UI.Views">

  <ControlTheme x:Key="{x:Type Window}" TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource AltimSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AltimTextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource AltimFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource AltimFontSizeBody}" />
    <Setter Property="TransparencyBackgroundFallback" Value="{DynamicResource AltimSurfaceBrush}" />
    <Setter Property="Template">
      <ControlTemplate TargetType="Window">
        <Panel>
          <Border Name="PART_TransparencyFallback"
                  IsHitTestVisible="False"
                  Background="{TemplateBinding TransparencyBackgroundFallback}" />
          <Border Name="PART_WindowGround" Background="{TemplateBinding Background}" />
          <Panel Margin="{TemplateBinding OffScreenMargin}">
            <Panel Margin="{TemplateBinding WindowDecorationMargin}">
              <VisualLayerManager Name="PART_VisualLayerManager">
                <ContentPresenter Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              </VisualLayerManager>
            </Panel>
          </Panel>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="AltimPopupWindow" TargetType="Window">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="TransparencyBackgroundFallback" Value="{DynamicResource AltimPopupBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AltimTextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource AltimFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource AltimFontSizeBody}" />
    <Setter Property="Width" Value="{DynamicResource AltimPopupWindowWidth}" />
    <Setter Property="views:PopupChrome.ShadowInset" Value="{DynamicResource AltimPopupShadowMargin}" />
    <Setter Property="Template">
      <ControlTemplate TargetType="Window">
        <Panel>
          <Border Name="PART_TransparencyFallback"
                  IsHitTestVisible="False"
                  Background="{TemplateBinding TransparencyBackgroundFallback}" />
          <Panel Margin="{TemplateBinding OffScreenMargin}">
            <Panel Margin="{TemplateBinding WindowDecorationMargin}">
              <VisualLayerManager Name="PART_VisualLayerManager">
                <Border Name="PART_PopupPanel"
                        ClipToBounds="False"
                        Width="{DynamicResource AltimPopupWidth}"
                        Margin="{TemplateBinding (views:PopupChrome.ShadowInset)}"
                        Background="{DynamicResource AltimPopupBackgroundBrush}"
                        BorderBrush="{DynamicResource AltimBorderBrush}"
                        BorderThickness="{DynamicResource AltimBorderThickness}"
                        CornerRadius="{DynamicResource AltimCornerRadius12}"
                        BoxShadow="{DynamicResource AltimPopupShadow}">
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                  </ScrollViewer>
                </Border>
              </VisualLayerManager>
            </Panel>
          </Panel>
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- No transparency, no shadow. The inset stays and paints in the fallback ground, so
         the panel sits exactly where it sits in the transparent case. -->
    <Style Selector="^[ActualTransparencyLevel=None] /template/ Border#PART_PopupPanel">
      <Setter Property="BoxShadow" Value="{DynamicResource AltimNoShadow}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
