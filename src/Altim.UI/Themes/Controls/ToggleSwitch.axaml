<!--
  ToggleSwitch.

  A settings row: label left, switch right, 28px minimum height. Off is an outlined track
  with a TextSecondary knob; on is a solid TextPrimary track with a Surface knob. The knob
  does not slide - DESIGN.md lists three motions and a toggle is not one of them - so the
  state reads as a position, not as an animation.

  The words "On" and "Off" are the framework's, not the brief's: ToggleSwitch defaults
  OnContent and OffContent to those strings and its default template prints them beside the
  pill. Both are nulled here AND their presenters are gone from the template, so neither a
  default nor a stray OnContent can put a word next to the switch. The state is the pill.

  The track is a pill: its radius is half its height. The knob inset is a hairline rather
  than a spacing step because the track's own 1px border already takes a pixel from each
  side - see AltimToggleKnobInset in Primitives.axaml.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ControlTheme x:Key="{x:Type ToggleSwitch}" TargetType="ToggleSwitch">
    <Setter Property="Background" Value="{DynamicResource AltimSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AltimTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AltimBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource AltimBorderThickness}" />
    <Setter Property="MinHeight" Value="{DynamicResource AltimRowMinHeight}" />
    <Setter Property="FontFamily" Value="{DynamicResource AltimFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource AltimFontSizeBody}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="OnContent" Value="{x:Null}" />
    <Setter Property="OffContent" Value="{x:Null}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate TargetType="ToggleSwitch">
        <Grid ColumnDefinitions="*,Auto">
          <ContentPresenter Name="PART_ContentPresenter"
                            Grid.Column="0"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center" />

          <Panel Grid.Column="1" VerticalAlignment="Center">
            <Border Name="PART_FocusRing"
                    IsVisible="False"
                    IsHitTestVisible="False"
                    Margin="{DynamicResource AltimFocusRingMargin}"
                    BorderThickness="{DynamicResource AltimFocusRingThickness}"
                    BorderBrush="{DynamicResource AltimFocusRingBrush}"
                    CornerRadius="{DynamicResource AltimCornerRadius8}" />
            <Border Name="PART_Track"
                    Width="{DynamicResource AltimToggleTrackWidth}"
                    Height="{DynamicResource AltimToggleTrackHeight}"
                    CornerRadius="{DynamicResource AltimToggleTrackRadius}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <Panel Name="PART_SwitchKnob" Margin="{DynamicResource AltimToggleKnobInset}">
                <Panel Name="PART_MovingKnobs"
                       HorizontalAlignment="Left"
                       Width="{DynamicResource AltimToggleKnobSize}"
                       Height="{DynamicResource AltimToggleKnobSize}">
                  <Border Name="PART_Knob"
                          CornerRadius="{DynamicResource AltimToggleKnobRadius}"
                          Background="{DynamicResource AltimTextSecondaryBrush}" />
                </Panel>
              </Panel>
            </Border>
          </Panel>
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:checked /template/ Panel#PART_MovingKnobs">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style Selector="^:checked /template/ Border#PART_Track">
      <Setter Property="Background" Value="{DynamicResource AltimTextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AltimTextPrimaryBrush}" />
    </Style>

    <Style Selector="^:checked /template/ Border#PART_Knob">
      <Setter Property="Background" Value="{DynamicResource AltimSurfaceBrush}" />
    </Style>

    <Style Selector="^:pointerover /template/ Border#PART_Track">
      <Setter Property="BorderBrush" Value="{DynamicResource AltimTextSecondaryBrush}" />
    </Style>

    <Style Selector="^:checked:pointerover /template/ Border#PART_Track">
      <Setter Property="BorderBrush" Value="{DynamicResource AltimTextPrimaryBrush}" />
    </Style>

    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{DynamicResource AltimDisabledOpacity}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
