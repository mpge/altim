<!--
  Button.

  DESIGN.md has no filled ACCENT button: colour carries provider identity and status only.
  It does not forbid a filled button, so the primary variant fills with TextPrimary - the
  same ink the figures are set in - and the rest do not fill at all. The default button is
  an outline (1px Border, Surface ground, TextPrimary label) and the two quiet variants
  remove the outline or move the outline and the label to StatusError.

  32px minimum height, radius 6, sentence case. The focus ring is a 2px TextPrimary ring
  offset 2px outside the control; it is a template part, not a setter, so no style can
  quietly remove it. Drawing outside the control's own bounds needs two things the theme
  must state: ClipToBounds="False", because TemplatedControl clips by default and would
  otherwise erase the ring, and FocusAdorner="{x:Null}", because the base theme's dashed
  rectangle is drawn by the framework and would otherwise appear beside it.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource AltimSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AltimTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AltimBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource AltimBorderThickness}" />
    <Setter Property="CornerRadius" Value="{DynamicResource AltimCornerRadius6}" />
    <Setter Property="Padding" Value="{DynamicResource AltimButtonPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource AltimButtonMinHeight}" />
    <Setter Property="FontFamily" Value="{DynamicResource AltimFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource AltimFontSizeBody}" />
    <Setter Property="FontWeight" Value="{DynamicResource AltimFontWeightLabel}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate TargetType="Button">
        <Panel>
          <Border Name="PART_FocusRing"
                  IsVisible="False"
                  IsHitTestVisible="False"
                  Margin="{DynamicResource AltimFocusRingMargin}"
                  BorderThickness="{DynamicResource AltimFocusRingThickness}"
                  BorderBrush="{DynamicResource AltimFocusRingBrush}"
                  CornerRadius="{DynamicResource AltimCornerRadius8}" />
          <Border Name="PART_Body"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#PART_Body">
      <Setter Property="Background" Value="{DynamicResource AltimHoverBrush}" />
    </Style>

    <Style Selector="^:pressed /template/ Border#PART_Body">
      <Setter Property="Background" Value="{DynamicResource AltimHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AltimTextSecondaryBrush}" />
    </Style>

    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{DynamicResource AltimDisabledOpacity}" />
    </Style>
  </ControlTheme>

  <!-- Primary: the one action a surface is asking for - "Retry", "Open Altim". It fills
       with TextPrimary and sets its label in Surface, which is the figure ink and the page
       ground, not an accent. One per surface. -->
  <ControlTheme x:Key="AltimPrimaryButton"
                TargetType="Button"
                BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource AltimTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AltimTextPrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AltimSurfaceBrush}" />

    <!-- Hover lightens the fill to the secondary ink rather than tinting it. -->
    <Style Selector="^:pointerover /template/ Border#PART_Body">
      <Setter Property="Background" Value="{DynamicResource AltimTextSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AltimTextSecondaryBrush}" />
    </Style>

    <Style Selector="^:pressed /template/ Border#PART_Body">
      <Setter Property="Background" Value="{DynamicResource AltimTextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AltimTextPrimaryBrush}" />
    </Style>
  </ControlTheme>

  <!-- Quiet: no ground, no outline. For the actions that sit beside a primary one. It is
       the button the popup and the sidebar use, so its hover cannot be the default one:
       AltimHoverBrush is SurfaceMuted, which is exactly the ground those two are painted
       on. It takes the next step along the same ramp instead - see States in DESIGN.md. -->
  <ControlTheme x:Key="AltimQuietButton"
                TargetType="Button"
                BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="{DynamicResource AltimBorderThicknessNone}" />
    <Setter Property="Foreground" Value="{DynamicResource AltimTextSecondaryBrush}" />

    <Style Selector="^:pointerover /template/ Border#PART_Body">
      <Setter Property="Background" Value="{DynamicResource AltimHoverMutedBrush}" />
    </Style>

    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AltimTextPrimaryBrush}" />
    </Style>

    <Style Selector="^:pressed /template/ Border#PART_Body">
      <Setter Property="Background" Value="{DynamicResource AltimHoverMutedBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
  </ControlTheme>

  <!-- Icon: a quiet button holding one 16px mark and nothing else, so it drops the label
       padding a word needs and keeps a square hit target instead. The gear in the panel's
       header and the disclosure beside a provider's name are both this. -->
  <ControlTheme x:Key="AltimIconButton"
                TargetType="Button"
                BasedOn="{StaticResource AltimQuietButton}">
    <Setter Property="Padding" Value="{DynamicResource AltimInset6}" />
    <Setter Property="MinHeight" Value="{DynamicResource AltimRowMinHeight}" />
    <Setter Property="MinWidth" Value="{DynamicResource AltimRowMinHeight}" />
  </ControlTheme>

  <!-- Text: an action set as a line of text rather than as a control. The panel's way out
       to the window is this rather than a filled button across the foot of it, because the
       panel already has a primary action - the tray icon it was opened from - and a second
       filled control competing with it is one too many on a surface this small. -->
  <ControlTheme x:Key="AltimTextButton"
                TargetType="Button"
                BasedOn="{StaticResource AltimQuietButton}">
    <Setter Property="Foreground" Value="{DynamicResource AltimTextPrimaryBrush}" />
    <Setter Property="Padding" Value="{DynamicResource AltimInset8}" />
    <Setter Property="MinHeight" Value="{DynamicResource AltimRowMinHeight}" />
    <Setter Property="FontWeight" Value="{DynamicResource AltimFontWeightHeading}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </ControlTheme>

  <!-- Destructive: status colour on the outline and the label. Never a red fill. -->
  <ControlTheme x:Key="AltimDestructiveButton"
                TargetType="Button"
                BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="{DynamicResource AltimStatusErrorBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AltimStatusErrorBrush}" />

    <Style Selector="^:pressed /template/ Border#PART_Body">
      <Setter Property="BorderBrush" Value="{DynamicResource AltimStatusErrorBrush}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
