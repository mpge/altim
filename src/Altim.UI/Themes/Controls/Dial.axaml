<!--
  Dial.

  The control draws itself; the theme only hands it brushes and measurements. The track, the
  engraving and the threshold index are still the meter's, key for key.

  The sweep is banded rather than one ink: AltimDialNormalBrush below half way,
  AltimDialCautionBrush from there to the configured threshold, AltimDialExceededBrush past
  it. The colour is a property of where the reading has reached, not a repaint of the whole
  instrument, and both boundaries stand on a mark the face draws anyway - the full depth
  graduation at 50 and the index at the threshold - so the picture survives having every hue
  removed. The words beside the dial still move to StatusWarn above the threshold, which a
  view does by binding to the dial's IsAboveThreshold.

  The engraving and the threshold index are the same ink, TextSecondary, and are told apart by
  geometry rather than by colour: the index is twice the weight of a graduation and is the
  only mark that crosses a ring. That ink is also what marks the ring a pointer or the
  keyboard is reading, traced round its band at a hairline. Three keys carry the one value
  because they are three roles.

  The focus ring is handed over as a brush, a weight and an offset rather than hosted as a
  template part, because there is no template. It carries no radius: the dial's ring is a
  circle concentric with the face, so the radius is the face's own. FocusAdorner is nulled for
  the reason every other focusable theme nulls it - the framework's dashed rectangle would be
  a second focus indicator drawn on top of this one - and ClipToBounds is off because the ring
  is drawn outside the control.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Altim.UI.Controls">

  <ControlTheme x:Key="{x:Type controls:Dial}" TargetType="controls:Dial">
    <Setter Property="TrackBrush" Value="{DynamicResource AltimMeterTrackBrush}" />
    <Setter Property="NormalBrush" Value="{DynamicResource AltimDialNormalBrush}" />
    <Setter Property="CautionBrush" Value="{DynamicResource AltimDialCautionBrush}" />
    <Setter Property="ExceededBrush" Value="{DynamicResource AltimDialExceededBrush}" />
    <Setter Property="ScaleBrush" Value="{DynamicResource AltimMeterScaleBrush}" />
    <Setter Property="ThresholdBrush" Value="{DynamicResource AltimMeterThresholdBrush}" />
    <Setter Property="FocusRingBrush" Value="{DynamicResource AltimFocusRingBrush}" />
    <Setter Property="FocusRingWidth" Value="{DynamicResource AltimFocusRingWidth}" />
    <Setter Property="FocusRingOffset" Value="{DynamicResource AltimFocusRingOffset}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Width" Value="{DynamicResource AltimDialSize}" />
    <Setter Property="Height" Value="{DynamicResource AltimDialSize}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </ControlTheme>

</ResourceDictionary>
