<Project Sdk="Microsoft.NET.Sdk">

  <!-- Two target frameworks.

       net10.0                        portable facade. This is the one every
                                      other project binds to, so Altim.App stays
                                      plain net10.0 and the solution restores and
                                      builds unchanged on Linux and macOS agents.

       net10.0-windows10.0.19041.0    the real implementation. Registry,
                                      Shell_NotifyIcon, Microsoft.Win32.SystemEvents
                                      and the Windows App SDK notification APIs all
                                      live behind the WINDOWS compilation symbol
                                      here, so CA1416 is satisfied by the target
                                      framework instead of by suppressions.

       EnableWindowsTargeting (set in Directory.Build.props) makes the Windows
       reference assemblies restore from nuget.org as
       Microsoft.Windows.SDK.NET.Ref, so the Windows inner build also compiles on
       non-Windows CI. -->

  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- The interop layer is written against pointers rather than marshalled
       structures: NOTIFYICONDATAW and PROCESSENTRY32W carry fixed-size string
       buffers, and the window procedure is an UnmanagedCallersOnly function
       pointer, which is what keeps the whole surface allocation free and Native
       AOT clean. Both need unsafe, and only the Windows target compiles it. -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Altim.Core\Altim.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
    <PackageReference Include="Microsoft.Win32.SystemEvents" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <!-- Microsoft.WindowsAppSDK brings the MSIX build tooling with it, and its MRT Core
       half runs MakePri.exe to index resources into a .pri file. MakePri.exe is a
       Windows x86 binary, so on a Linux agent the inner Windows build fails at
       MSB6003 with "Exec format error" — which is what turned this project's second
       target framework into a Linux CI failure.

       EnableCoreMrtTooling=false skips that step. It is safe here for a reason
       specific to this project rather than a general one: Altim is an unpackaged
       desktop application, this assembly has no .resw, .resjson or image resources to
       index, and the only thing it takes from the Windows App SDK is
       AppNotificationManager, whose registration reads nothing out of a .pri. The
       PRI expansion target still runs and is a no-op without a MakePri path.

       Scoped to non-Windows hosts on purpose. The Windows build — the one that is
       shipped, published with Native AOT and run — is left byte for byte as it was,
       so this cannot change what a user installs. -->
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <!-- The tray icon is loaded from a file at run time rather than from an embedded
       resource, because the shell wants an HICON at exactly the size the current
       DPI asks for and GDI+ decodes a file directly. The renderings macOS uses are
       left out; only the dark glyph, the light glyph and the multi-size .ico are
       needed here. -->
  <ItemGroup>
    <None Include="..\..\assets\icons\altim.ico;..\..\assets\icons\altim-*.png"
          Exclude="..\..\assets\icons\altim-template-*.png">
      <Link>assets\icons\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

</Project>
