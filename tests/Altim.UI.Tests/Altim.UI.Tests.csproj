<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Altim.UI\Altim.UI.csproj" />
    <!-- Altim.Platform.Linux for one pure function: which executable an autostart
         entry should name, which is the difference between a working "start at
         login" and a dead one inside an AppImage. It cannot be exercised on the
         machine that builds it, but the choice itself is arithmetic over three
         strings and is asserted in LinuxAutoStartPathTests. Nothing in this
         reference is initialised: no tray icon is created and no bus is connected. -->
    <ProjectReference Include="..\..\src\Altim.Platform.Linux\Altim.Platform.Linux.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <!-- Headless drawing renders nothing, so a captured frame comes back null. Skia is what
         makes CaptureRenderedFrame return real pixels, and Avalonia.Desktop is the only
         centrally versioned package that carries it: Directory.Packages.props has no
         PackageVersion for Avalonia.Skia, and this project cannot add one. No windowing
         backend is initialised, because the session is headless. -->
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

</Project>
